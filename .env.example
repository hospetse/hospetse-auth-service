DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
PORT=3001
PIN_HMAC_SECRET=
BACKEND_URL="http://localhost:3000"
# Origens do navegador que podem chamar o Auth, separadas por vírgula (Expo web: 8081)
CORS_ORIGINS="http://localhost:8081"
# Segredo compartilhado com o back-end (mesmo valor nos dois .env). Gerar: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=
# Par RS256 em PEM, entre aspas duplas (pode ter várias linhas). Gerar com openssl: ver README
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Seed manual #497: preencher somente no .env privado, nunca versionar senhas reais.
SEED_ADMIN_PASSWORD=
SEED_TUTOR_PASSWORD=
# Envio do PIN pelo Resend. Sem a chave, o index.js usa o ConsoleEmailSender (PIN no terminal)
RESEND_API_KEY=
EMAIL_FROM="Hospetse <no-reply@hospetse.com.br>"
